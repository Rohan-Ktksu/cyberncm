# Copy to .env (never commit .env). The code reads these from the process environment;
# load them with your shell or a tool of your choice. All values below are placeholders or safe defaults.

# --- Frozen detector artifacts for the local demo (NOT included in this repository) ---
# Build them yourself as described in the README (download dataset -> prep -> train -> export).
CYBERNCM_CHECKPOINT=artifacts/ncm_gru64_s0.pt
CYBERNCM_WINDOWS=data/windows.npz

# --- Local two-node demo (everything binds to 127.0.0.1 only) ---
CYBERNCM_DEMO_RUNTIME=demo/two_node/runtime    # keys and state; generated on first run, git-ignored
CYBERNCM_NODE_A_PORT=18200
CYBERNCM_NODE_B_PORT=18100
CYBERNCM_LAB_PORT=18080
# Human approval is the default. Set to 1 ONLY for the explicit, bounded lab mode
# (one automatic block per allowlisted client per process, at most 10 seconds, no renewal).
# The launcher ignores an inherited value unless --autonomous-lab is passed.
CYBERNCM_AUTONOMOUS_LAB=0

# --- Single-site console (shadow mode only; blocks nothing) ---
CYBERNCM_DB=cyberncm.db

# --- Research scripts ---
NCM_THREADS=2    # CPU threads for torch and the forests; speed only
